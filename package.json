{
  "name": "robotic-tyler-control-center",
  "version": "2.15.0",
  "private": true,
  "description": "Text-only Control Center, native Steam audio companion, and Chrome extension",
  "main": "app/main.cjs",
  "author": "ROBOTIC TYLER",
  "scripts": {
    "start": "node tools/build.mjs && electron .",
    "start:voice": "electron voice-app/native-main.cjs",
    "build:win": "npm run build:both && npm run build:setup",
    "build:installer": "node tools/build.mjs && electron-builder --win nsis --x64",
    "build:control": "node tools/build.mjs && electron-builder --win nsis --x64 --config electron-builder.control.json --publish never",
    "build:voice": "node tools/build.mjs && electron-builder --win nsis --x64 --config electron-builder.voice.json --publish never",
    "build:both": "npm run build:control && npm run build:voice",
    "build:setup": "node tools/setup/build-setup.mjs",
    "build:sources": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.mjs\"",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "preview": "node tools/preview/shoot.mjs",
    "release:control": "node tools/build.mjs && electron-builder --win nsis --x64 --config electron-builder.control.json --publish always",
    "release:voice": "node tools/build.mjs && electron-builder --win nsis --x64 --config electron-builder.voice.json --publish always",
    "release": "npm run release:control && npm run release:voice",
    "package:release": "node tools/package-release.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.robotictyler.controlcenter",
    "productName": "ROBOTIC TYLER Control Center",
    "asar": true,
    "directories": {
      "app": ".",
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/node_modules/.cache/**/*",
      "!app/desktop-overrides/**/*"
    ],
    "win": {
      "icon": "assets/robotic-tyler.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ROBOTIC-TYLER-Control-Center-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "ROBOTIC TYLER",
      "shortcutName": "ROBOTIC TYLER Control Center",
      "uninstallDisplayName": "ROBOTIC TYLER Control Center",
      "installerIcon": "assets/robotic-tyler.ico",
      "uninstallerIcon": "assets/robotic-tyler.ico",
      "installerHeaderIcon": "assets/robotic-tyler.ico",
      "installerSidebar": "build/installer-sidebar-control.bmp",
      "uninstallerSidebar": "build/installer-sidebar-control.bmp",
      "installerHeader": "build/installer-header.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ROBOTIC-TYLER-component-Control-Center-${version}.${ext}"
    },
    "extraMetadata": {
      "main": "app/main.cjs",
      "description": "ROBOTIC TYLER Control Center"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "treymun",
        "repo": "Robotic-Tyler",
        "releaseType": "release",
        "channel": "control"
      }
    ],
    "copyright": "© 2026 ROBOTIC TYLER"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
