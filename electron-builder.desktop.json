{
  "appId": "com.robotictyler.controlcenter",
  "productName": "ROBOTIC TYLER",
  "asar": true,
  "directories": {
    "app": ".",
    "output": "dist/desktop",
    "buildResources": "build"
  },
  "files": [
    "app/**/*",
    "voice-app/**/*",
    "assets/**/*",
    "browser-extension/neural-host.html",
    "browser-extension/neural-host.mjs",
    "browser-extension/neural/**/*",
    "!assets/theme-logos/**/*",
    "!**/*.map",
    "!**/node_modules/.cache/**/*",
    "!app/desktop-overrides/**/*"
  ],
  "win": {
    "icon": "assets/robotic-tyler.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "ROBOTIC-TYLER-Desktop-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "menuCategory": "ROBOTIC TYLER",
    "shortcutName": "ROBOTIC TYLER",
    "uninstallDisplayName": "ROBOTIC TYLER",
    "installerIcon": "assets/robotic-tyler.ico",
    "uninstallerIcon": "assets/robotic-tyler.ico",
    "installerHeaderIcon": "assets/robotic-tyler.ico",
    "installerSidebar": "build/installer-sidebar-control.bmp",
    "uninstallerSidebar": "build/installer-sidebar-control.bmp",
    "installerHeader": "build/installer-header.bmp",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "ROBOTIC-TYLER-component-Desktop-${version}.${ext}"
  },
  "extraMetadata": {
    "main": "app/main.cjs",
    "description": "ROBOTIC TYLER: Steam text chat and voice"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "treymun",
      "repo": "Robotic-Tyler",
      "releaseType": "release",
      "channel": "control"
    }
  ],
  "copyright": "\u00a9 2026 ROBOTIC TYLER",
  "extraResources": [
    {
      "from": "windows-audio-bridge/publish",
      "to": "windows-audio-bridge",
      "filter": [
        "**/*"
      ]
    }
  ]
}
