{
  "appId": "com.robotictyler.nativesteamcompanion",
  "productName": "ROBOTIC TYLER Native Steam Companion",
  "asar": true,
  "directories": {
    "app": ".",
    "output": "dist/native-steam-companion",
    "buildResources": "build"
  },
  "files": [
    "voice-app/**/*",
    "app/**/*",
    "assets/**/*",
    "!**/*.map",
    "!app/desktop-overrides/**/*"
  ],
  "win": {
    "icon": "assets/robotic-tyler.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "ROBOTIC-TYLER-Native-Steam-Companion-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "menuCategory": "ROBOTIC TYLER",
    "shortcutName": "ROBOTIC TYLER Native Steam Companion",
    "uninstallDisplayName": "ROBOTIC TYLER Native Steam Companion",
    "installerIcon": "assets/robotic-tyler.ico",
    "uninstallerIcon": "assets/robotic-tyler.ico",
    "installerHeaderIcon": "assets/robotic-tyler.ico",
    "installerSidebar": "build/installer-sidebar-voice.bmp",
    "uninstallerSidebar": "build/installer-sidebar-voice.bmp",
    "installerHeader": "build/installer-header.bmp",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "ROBOTIC-TYLER-component-Native-Steam-Companion-${version}.${ext}"
  },
  "extraMetadata": {
    "main": "voice-app/native-main.cjs",
    "description": "ROBOTIC TYLER Native Steam Companion",
    "name": "robotic-tyler-native-steam-companion"
  },
  "extraResources": [
    {
      "from": "windows-audio-bridge/publish",
      "to": "windows-audio-bridge",
      "filter": [
        "**/*"
      ]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "treymun",
      "repo": "Robotic-Tyler",
      "releaseType": "release",
      "channel": "voice"
    }
  ],
  "copyright": "© 2026 ROBOTIC TYLER"
}
