# Keep LF everywhere (the generated files and the trivia source are compared byte for byte),
# including on Windows checkouts such as the CI's Windows runner.
* text=auto eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.bmp binary
*.wav binary
*.woff2 binary
*.wasm binary
*.onnx binary
# Pack 3's source files are kept byte for byte as the pack supplied them (their SHA-256 is checked).
assets/theme-visual-pack-3/source/** -text
